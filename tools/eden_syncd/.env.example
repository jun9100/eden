# Use independent, long random secrets. Do not commit the real .env file.
EDEN_SYNCD_TOKEN=replace-with-a-long-random-sync-token
EDEN_SYNCD_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token

# Bind only to the NAS private address, never 0.0.0.0 for a LAN-only service.
EDEN_SYNCD_BIND_ADDRESS=192.168.12.14
EDEN_SYNCD_PORT=8788
EDEN_SYNCD_DATA_DIR=/var/lib/eden-syncd
EDEN_SYNCD_IMAGE=jun9100/eden-syncd:latest
