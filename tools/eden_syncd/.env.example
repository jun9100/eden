# Use independent, long random secrets. Do not commit the real .env file.
EDEN_SYNCD_TOKEN=replace-with-a-long-random-sync-token
EDEN_SYNCD_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token

# Optional OpenSave WebDAV credentials. Set both to enable the separate /opensave/ endpoint.
# Do not reuse either Eden token here.
EDEN_SYNCD_OPENSAVE_USERNAME=opensave
EDEN_SYNCD_OPENSAVE_PASSWORD=replace-with-a-third-long-random-secret

# Bind only to the NAS private address, never 0.0.0.0 for a LAN-only service.
EDEN_SYNCD_BIND_ADDRESS=192.168.12.14
EDEN_SYNCD_PORT=8788
EDEN_SYNCD_DATA_DIR=/var/lib/eden-syncd
EDEN_SYNCD_IMAGE=jun9100/eden-syncd:latest

# Optional snapshot retention defaults (0 = unlimited). Once changed in the dashboard,
# the dashboard value stored in data/settings.json takes precedence.
EDEN_SYNCD_KEEP_SNAPSHOTS=0
EDEN_SYNCD_KEEP_DAYS=0

# Dashboard timestamps use the browser's time zone; TZ only affects server logs.
TZ=Asia/Shanghai

# Set these to the owner UID/GID of EDEN_SYNCD_DATA_DIR on the NAS.
PUID=10001
PGID=10001
